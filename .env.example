# Frontend public configuration. NEVER include credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1
# Server-only local backend endpoint; used by /api/health route.
BACKEND_INTERNAL_URL=http://127.0.0.1:4000/api/v1

# Enable only on verified DigitalOcean ingress. Never expose the shared secret as NEXT_PUBLIC_.
AUTH_TRUST_DO_CONNECTING_IP=false
# AUTH_PROXY_CLIENT_IP_HMAC_KEY=
