{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "Public endpoint; no authentication or permission is required. Creates a pending-verification account. A duplicate canonical email receives the same accepted response. Email verification is performed by the separate OTP workflow. Linear: REN2-21.",
        "operationId": "registerWithEmailAndPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequestDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Generic accepted result; does not reveal whether the email is already registered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationAcceptedDto"
                }
              }
            }
          },
          "400": {
            "description": "AUTH_INPUT_INVALID. Invalid email, unsupported fields, or password outside the 15 to 128 character policy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "AUTH_RATE_LIMITED. Registration limit exceeded.",
            "headers": {
              "Retry-After": {
                "description": "Seconds before retrying.",
                "schema": {
                  "type": "integer",
                  "example": 900
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "AUTH_INTERNAL_ERROR. Unexpected failure with a safe public message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "AUTH_SERVICE_UNAVAILABLE. PostgreSQL or Redis is unavailable; registration fails closed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          }
        },
        "summary": "Begin first-party email registration",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/sessions": {
      "post": {
        "description": "Public endpoint; no existing authentication or permission is required. Unknown, inactive, unverified, and incorrect credentials share one failure response. Success issues an opaque host-only cookie; only its SHA-256 digest is stored. Linear: REN2-21.",
        "operationId": "createPasswordSession",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordSessionRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated minimal identity and opaque session cookie.",
            "schema": {
              "example": {
                "authenticationState": "authenticated",
                "user": {
                  "id": "7d785d72-ea2c-44bb-9d82-87b272112b32"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly; Secure; SameSite=Lax; Path=/; no Domain attribute.",
                "schema": {
                  "type": "string",
                  "example": "__Host-renivet_session=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA; Path=/; Max-Age=1800; HttpOnly; Secure; SameSite=Lax"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordSessionResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "AUTH_INPUT_INVALID. Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_FAILED. Generic credential verification failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "AUTH_RATE_LIMITED. Authentication limit exceeded.",
            "headers": {
              "Retry-After": {
                "description": "Seconds before retrying.",
                "schema": {
                  "type": "integer",
                  "example": 900
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "AUTH_INTERNAL_ERROR. Unexpected failure with a safe public message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "AUTH_SERVICE_UNAVAILABLE. PostgreSQL or Redis is unavailable; authentication fails closed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          }
        },
        "summary": "Authenticate with a verified email and password",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "description": "Requires a valid opaque session cookie. Returns a minimal user identity and a session-bound CSRF token for same-origin mutations. Idle expiry is extended up to the seven-day absolute limit. Linear: REN2-23.",
        "operationId": "getCurrentSession",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Active identity and session-bound CSRF token; refreshes the session cookie to its server-calculated idle expiry, capped by its absolute expiry.",
            "headers": {
              "Cache-Control": {
                "description": "Sensitive session response must not be cached.",
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              },
              "Set-Cookie": {
                "description": "Refreshed host-only session cookie, capped at the server-calculated idle/absolute expiry.",
                "schema": {
                  "type": "string",
                  "example": "__Host-renivet_session=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA; Path=/; Max-Age=1800; HttpOnly; Secure; SameSite=Lax"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "authenticationState": "authenticated",
                    "user": {
                      "id": "7d785d72-ea2c-44bb-9d82-87b272112b32"
                    },
                    "csrfToken": "synthetic-csrf-token"
                  }
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_FAILED. Missing, expired, revoked or invalid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "AUTH_INTERNAL_ERROR. Unexpected failure with a safe public message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "AUTH_SERVICE_UNAVAILABLE. Session store or CSRF configuration is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "renivetSession": []
          }
        ],
        "summary": "Inspect the authenticated first-party session",
        "tags": [
          "Auth"
        ]
      },
      "delete": {
        "description": "Requires a valid session cookie, exact allowlisted Origin, Sec-Fetch-Site: same-origin, and the session-bound X-CSRF-Token returned by GET /auth/session. Revocation is server-side before the cookie is expired. Linear: REN2-23.",
        "operationId": "logoutCurrentSession",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Must equal the session-bound proof returned by GET /auth/session.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Sec-Fetch-Site",
            "in": "header",
            "description": "Must be same-origin.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "same-origin"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "description": "Must exactly match one configured AUTH_ALLOWED_ORIGINS origin.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "https://app.example.test"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session revoked and host-only cookie expired.",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "logged_out"
                  }
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_FAILED. Session is not active.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "CSRF_VALIDATION_FAILED. Origin, fetch metadata or CSRF evidence is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "AUTH_INTERNAL_ERROR. Unexpected failure with a safe public message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "AUTH_SERVICE_UNAVAILABLE. Session store or CSRF configuration is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "renivetSession": []
          }
        ],
        "summary": "Revoke the current session",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/challenges": {
      "post": {
        "description": "Public operation with no authentication or permission requirement. Creates a short-lived one-use challenge for an eligible contact and purpose. Password recovery is available only to an active account with verified email and an active password credential; unknown and ineligible contacts receive a neutral accepted response. Recovery proof is purpose-bound and is required to replace the password. Delivery is unavailable by default until a provider has separately passed owner review. Verification: Linear REN2-22; password recovery: REN2-23; candidate routes remain subject to D04 owner approval.",
        "operationId": "createOtpChallenge",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpIssueRequestDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Neutral accepted result; does not reveal contact registration or delivery state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpAcceptedDto"
                }
              }
            }
          },
          "400": {
            "description": "AUTH_INPUT_INVALID. Invalid channel/purpose pair or malformed destination.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "AUTH_RATE_LIMITED. Per-IP, identity, purpose, cooldown, or resend limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "AUTH_INTERNAL_ERROR. Unexpected failure with a safe response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "AUTH_SERVICE_UNAVAILABLE. Redis, PostgreSQL, OTP proof configuration, or delivery provider is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          }
        },
        "summary": "Request an email or phone verification or recovery challenge",
        "tags": [
          "Otp"
        ]
      }
    },
    "/api/v1/auth/challenges/{challengeId}/verify": {
      "post": {
        "description": "Public operation with no authentication or permission requirement. A successful verification proof marks only the bound contact as verified and issues no session. A password_recovery proof additionally requires a newPassword, atomically replaces the active Argon2id password credential, increments its version, and revokes every existing session. Invalid, expired, wrong-purpose, exhausted, or replayed proofs share one generic denial. Linear: REN2-22 verification and REN2-23 password recovery; candidate route remains subject to D04 owner approval.",
        "operationId": "verifyOtpChallenge",
        "parameters": [
          {
            "name": "challengeId",
            "required": true,
            "in": "path",
            "description": "Opaque UUID returned by the challenge request operation.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "37a7d0bf-8414-4f75-bd11-311c7a442d84"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerifyRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The challenge is consumed and its bound contact is verified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpVerifiedDto"
                }
              }
            }
          },
          "400": {
            "description": "AUTH_INPUT_INVALID. Malformed request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_FAILED. Generic challenge denial.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "AUTH_RATE_LIMITED. Per-IP or concurrent challenge limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "AUTH_INTERNAL_ERROR. Unexpected failure with a safe response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "AUTH_SERVICE_UNAVAILABLE. Redis, PostgreSQL, or OTP proof configuration is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          }
        },
        "summary": "Verify a one-use challenge or reset a password through recovery",
        "tags": [
          "Otp"
        ]
      }
    },
    "/api/v1/auth/mfa": {
      "get": {
        "description": "Requires the first-party session cookie. Returns factor state and remaining recovery-code count only; it never returns an authenticator secret, TOTP, or recovery code. Linear: REN2-24.",
        "operationId": "getMfaStatus",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current MFA enrollment state without factor material.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaStatusResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_FAILED. The session is missing, expired, revoked, or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "AUTH_INTERNAL_ERROR. Unexpected failure with a safe public message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "AUTH_SERVICE_UNAVAILABLE. The identity store is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "renivetSession": []
          }
        ],
        "summary": "Inspect the authenticated account MFA status",
        "tags": [
          "Mfa"
        ]
      }
    },
    "/api/v1/auth/mfa/enrollments": {
      "post": {
        "description": "Requires an authenticated session, exact allowlisted Origin, Sec-Fetch-Site: same-origin, and session-bound X-CSRF-Token. Creates one short-lived pending TOTP factor and returns its provisioning URI once. One active or unexpired pending factor is allowed. Linear: REN2-24.",
        "operationId": "beginMfaEnrollment",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Session-bound proof returned by GET /auth/session.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Sec-Fetch-Site",
            "in": "header",
            "description": "Must be same-origin.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "same-origin"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "description": "Must exactly match a configured AUTH_ALLOWED_ORIGINS origin.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "http://127.0.0.1:3000"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One-time authenticator provisioning URI, expiring after 10 minutes.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaEnrollmentResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_FAILED. The session is not active.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "CSRF_VALIDATION_FAILED. Origin, fetch metadata, or CSRF evidence is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "AUTH_MFA_ENROLLMENT_UNAVAILABLE. A factor is already pending or enabled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "AUTH_RATE_LIMITED. Enrollment request limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "AUTH_INTERNAL_ERROR. Unexpected failure with a safe public message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "AUTH_SERVICE_UNAVAILABLE. MFA encryption key, Redis, PostgreSQL or audit storage is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "renivetSession": []
          }
        ],
        "summary": "Begin authenticator-app MFA enrollment",
        "tags": [
          "Mfa"
        ]
      }
    },
    "/api/v1/auth/mfa/enrollments/verify": {
      "post": {
        "description": "Requires an authenticated session, exact allowlisted Origin, same-origin fetch metadata, and session-bound CSRF proof. A valid TOTP activates the pending factor, rotates the session, and returns ten 128-bit recovery codes once. TOTP enrollment proof cannot be replayed. Linear: REN2-24.",
        "operationId": "confirmMfaEnrollment",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Session-bound proof returned by GET /auth/session.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Sec-Fetch-Site",
            "in": "header",
            "description": "Must be same-origin.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "same-origin"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "description": "Must exactly match a configured AUTH_ALLOWED_ORIGINS origin.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaEnrollmentCodeRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Activated factor, one-time recovery codes, rotated secure session cookie, and fresh CSRF proof.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "example": "__Host-renivet_session=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA; Path=/; Max-Age=1800; HttpOnly; Secure; SameSite=Lax"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaEnabledResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "AUTH_INPUT_INVALID. Code is not a six-digit TOTP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_FAILED or AUTH_MFA_PROOF_INVALID. Session/factor proof is invalid, expired, or replayed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "CSRF_VALIDATION_FAILED. Origin, fetch metadata, or CSRF evidence is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "AUTH_RATE_LIMITED. Enrollment verification limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "AUTH_INTERNAL_ERROR. Unexpected failure with a safe public message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "AUTH_SERVICE_UNAVAILABLE. MFA encryption key, Redis, PostgreSQL or audit storage is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "renivetSession": []
          }
        ],
        "summary": "Confirm the authenticator factor and reveal recovery codes",
        "tags": [
          "Mfa"
        ]
      }
    },
    "/api/v1/auth/mfa/step-up": {
      "post": {
        "description": "Requires an authenticated session and the same-origin CSRF protections. Valid TOTP or an unused recovery code is consumed atomically, the opaque session is rotated, and only the new server-side session receives an MFA verification timestamp. Elevation is fresh for 300 seconds. Linear: REN2-24.",
        "operationId": "stepUpWithMfa",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Session-bound proof returned by GET /auth/session.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Sec-Fetch-Site",
            "in": "header",
            "description": "Must be same-origin.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "same-origin"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "description": "Must exactly match a configured AUTH_ALLOWED_ORIGINS origin.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaStepUpRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Elevated session cookie and fresh CSRF proof.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "example": "__Host-renivet_session=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA; Path=/; Max-Age=1800; HttpOnly; Secure; SameSite=Lax"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaStepUpResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "AUTH_INPUT_INVALID. Proof is neither a six-digit TOTP nor a 26-character recovery code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_FAILED or AUTH_MFA_PROOF_INVALID. Session, factor, or one-time recovery proof is invalid or replayed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "CSRF_VALIDATION_FAILED. Origin, fetch metadata, or CSRF evidence is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "AUTH_RATE_LIMITED. MFA verification limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "AUTH_INTERNAL_ERROR. Unexpected failure with a safe public message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "AUTH_SERVICE_UNAVAILABLE. MFA encryption key, Redis, PostgreSQL or audit storage is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "renivetSession": []
          }
        ],
        "summary": "Elevate the current session with TOTP or a recovery code",
        "tags": [
          "Mfa"
        ]
      }
    },
    "/api/v1/auth/mfa/factor": {
      "delete": {
        "description": "Requires an authenticated session, same-origin CSRF protections, and a successful step-up no older than 300 seconds. Revocation erases encrypted factor material, consumes remaining recovery codes, revokes all user sessions, and expires the current cookie. There is no support bypass. Linear: REN2-24.",
        "operationId": "revokeMfaFactor",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Session-bound proof returned by GET /auth/session or the latest MFA response.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Sec-Fetch-Site",
            "in": "header",
            "description": "Must be same-origin.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "same-origin"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "description": "Must exactly match a configured AUTH_ALLOWED_ORIGINS origin.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Factor revoked and current secure session cookie expired.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "example": "__Host-renivet_session=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaRevocationResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_FAILED. The session is not active.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "CSRF_VALIDATION_FAILED or AUTH_MFA_STEP_UP_REQUIRED. CSRF or fresh MFA evidence is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "AUTH_RATE_LIMITED. Authentication limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "AUTH_INTERNAL_ERROR. Unexpected failure with a safe public message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "AUTH_SERVICE_UNAVAILABLE. PostgreSQL or audit storage is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "renivetSession": []
          }
        ],
        "summary": "Revoke the current authenticator factor",
        "tags": [
          "Mfa"
        ]
      }
    }
  },
  "info": {
    "title": "Renivet API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "renivetSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-renivet_session"
      }
    },
    "schemas": {
      "RegisterRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "buyer@example.test",
            "description": "Canonicalized by trimming surrounding whitespace and lowercasing before lookup and storage."
          },
          "password": {
            "type": "string",
            "minLength": 15,
            "maxLength": 128,
            "description": "A 15–128 character passphrase. No composition rule is imposed.",
            "example": "synthetic example passphrase only"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RegistrationAcceptedDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "accepted"
            ],
            "example": "accepted"
          }
        },
        "required": [
          "status"
        ]
      },
      "AuthErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "AUTH_INPUT_INVALID",
              "AUTHENTICATION_FAILED",
              "AUTH_RATE_LIMITED",
              "AUTH_SERVICE_UNAVAILABLE",
              "AUTH_INTERNAL_ERROR",
              "AUTH_MFA_PROOF_INVALID",
              "AUTH_MFA_STEP_UP_REQUIRED",
              "AUTH_MFA_ENROLLMENT_UNAVAILABLE",
              "CSRF_VALIDATION_FAILED"
            ]
          },
          "message": {
            "type": "string",
            "example": "The request could not be processed."
          },
          "requestId": {
            "type": "string",
            "example": "req-1"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "PasswordSessionRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "buyer@example.test",
            "description": "Canonicalized by trimming surrounding whitespace and lowercasing before lookup and storage."
          },
          "password": {
            "type": "string",
            "minLength": 15,
            "maxLength": 128,
            "description": "A 15–128 character passphrase. No composition rule is imposed.",
            "example": "synthetic example passphrase only"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthenticatedUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "PasswordSessionResponseDto": {
        "type": "object",
        "properties": {
          "authenticationState": {
            "type": "string",
            "enum": [
              "authenticated"
            ],
            "example": "authenticated"
          },
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUserDto"
          }
        },
        "required": [
          "authenticationState",
          "user"
        ]
      },
      "OtpIssueRequestDto": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "email",
              "phone"
            ],
            "example": "email"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "email_verification",
              "phone_verification",
              "password_recovery"
            ],
            "example": "email_verification"
          },
          "destination": {
            "type": "string",
            "example": "buyer@example.test",
            "description": "Email address or E.164 phone number. The requested channel and purpose must match."
          }
        },
        "required": [
          "channel",
          "purpose",
          "destination"
        ]
      },
      "OtpAcceptedDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "accepted"
            ],
            "example": "accepted"
          },
          "challengeId": {
            "type": "string",
            "format": "uuid",
            "example": "37a7d0bf-8414-4f75-bd11-311c7a442d84",
            "description": "Opaque challenge reference; unknown contacts receive an unusable synthetic reference to keep results enumeration-neutral."
          }
        },
        "required": [
          "status",
          "challengeId"
        ]
      },
      "OtpVerifyRequestDto": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "email_verification",
              "phone_verification",
              "password_recovery"
            ],
            "example": "email_verification"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "example": "123456",
            "description": "Six-digit synthetic example. Real codes are delivered out of band."
          },
          "newPassword": {
            "type": "string",
            "minLength": 15,
            "maxLength": 128,
            "example": "synthetic replacement passphrase",
            "description": "Required only for password_recovery; accepted as a passphrase and stored only as an Argon2id hash."
          }
        },
        "required": [
          "purpose",
          "code"
        ]
      },
      "OtpVerifiedDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verified"
            ],
            "example": "verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "MfaStatusResponseDto": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "not_enrolled",
              "enrollment_pending",
              "enabled"
            ],
            "example": "not_enrolled"
          },
          "recoveryCodesRemaining": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "example": 0
          }
        },
        "required": [
          "state",
          "recoveryCodesRemaining"
        ]
      },
      "MfaEnrollmentResponseDto": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "enrollment_pending"
            ],
            "example": "enrollment_pending"
          },
          "provisioningUri": {
            "type": "string",
            "format": "uri",
            "example": "otpauth://totp/Renivet:00000000-0000-4000-8000-000000000000?secret=JBSWY3DPEHPK3PXP&issuer=Renivet&algorithm=SHA1&digits=6&period=30",
            "description": "Contains the authenticator secret. Shown only in the start response and never returned by status or retries."
          },
          "expiresInSeconds": {
            "type": "integer",
            "example": 600
          }
        },
        "required": [
          "state",
          "provisioningUri",
          "expiresInSeconds"
        ]
      },
      "MfaEnrollmentCodeRequestDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "example": "123456",
            "description": "Six-digit TOTP from the authenticator app. Synthetic example only."
          }
        },
        "required": [
          "code"
        ]
      },
      "MfaEnabledResponseDto": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "enabled"
            ],
            "example": "enabled"
          },
          "recoveryCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z2-7]{26}$"
            },
            "example": [
              "JBSWY3DPEHPK3PXPJBSWY3DPEH"
            ],
            "description": "One-time recovery codes. Save them now; the API stores only SHA-256 digests and never returns them again."
          },
          "csrfToken": {
            "type": "string",
            "example": "synthetic-csrf-proof-for-rotated-session"
          }
        },
        "required": [
          "state",
          "recoveryCodes",
          "csrfToken"
        ]
      },
      "MfaStepUpRequestDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^(?:\\d{6}|[A-Z2-7]{26})$",
            "example": "123456",
            "description": "Six-digit TOTP or one 26-character recovery code. Synthetic example only."
          }
        },
        "required": [
          "code"
        ]
      },
      "MfaStepUpResponseDto": {
        "type": "object",
        "properties": {
          "authenticationState": {
            "type": "string",
            "enum": [
              "elevated"
            ],
            "example": "elevated"
          },
          "csrfToken": {
            "type": "string",
            "example": "synthetic-csrf-proof-for-rotated-session"
          }
        },
        "required": [
          "authenticationState",
          "csrfToken"
        ]
      },
      "MfaRevocationResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "revoked"
            ],
            "example": "revoked"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
